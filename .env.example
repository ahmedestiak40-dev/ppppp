# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================
# ESTIAK AHMED PORTFOLIO & CMS CONFIGURATION (MongoDB + Node.js)
# ==============================================================

# MONGODB_URI: MongoDB connection string (Local or MongoDB Atlas)
# For local MongoDB on your laptop:
# MONGODB_URI="mongodb://localhost:27017/estiak_portfolio"
# For MongoDB Atlas (Free Cloud Cluster):
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/estiak_portfolio?retryWrites=true&w=majority"
# Note: If MONGODB_URI is not set, the app runs smoothly with local JSON persistence in ./data/portfolio.json.
MONGODB_URI="mongodb://localhost:27017/estiak_portfolio"

# ADMIN_PASSWORD: Passcode to access the Admin Panel CMS
ADMIN_PASSWORD="admin123"

# PORT: Server port (defaults to 3000)
PORT=3000
